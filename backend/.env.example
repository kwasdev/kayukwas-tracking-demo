# ==============================================================================
# Kayu KWAS Tracking & Production System - Backend Environment Config
# ==============================================================================

PORT=8080
DB_DRIVER=sqlite
DB_NAME=kayukwas.db
JWT_SECRET=super-secret-jwt-key-for-kayukwas-production-2026
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Agentic AI Engine (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Provider: gemini | openai | local
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Masukkan API Key Google AI Studio / Gemini Anda di sini:
GEMINI_API_KEY=

# (Opsional) Jika menggunakan provider OpenAI:
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# OpenWA WhatsApp Gateway Integration
# ------------------------------------------------------------------------------
# URL Server OpenWA Gateway instance (misal http://localhost:8000 atau https://wa.kayukwas.co.id)
OPENWA_URL=http://localhost:8000

# API Key untuk autentikasi kirim pesan outbound dari sistem ke WhatsApp
OPENWA_API_KEY=kayukwas-openwa-production-key-2026

# HMAC-SHA256 secret untuk memverifikasi keaslian webhook masuk dari OpenWA
OPENWA_WEBHOOK_SECRET=kayukwas-openwa-webhook-secret-2026
